<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Tugas modul 2, pertama"/>
        <attribute name="authors" value="BINTANG86"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 12:33:00 PM"/>
        <attribute name="created" value="QklOVEFORzg2O0RFU0tUT1AtRzNTME0yOTsyMDI2LTEwLTA3OzEyOjA4OjA3IFBNOzI5MjU="/>
        <attribute name="edited" value="QklOVEFORzg2O0RFU0tUT1AtRzNTME0yOTsyMDI2LTEwLTA3OzEyOjMzOjAwIFBNOzE7MzAyNA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kode, digit1, digit2, digit3, pelacakAwal, pelacakTahap1, nilaiAkhir" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukan kode 3 digit: &quot;" newline="True"/>
            <input variable="kode"/>
            <assign variable="digit1" expression="kode / 100"/>
            <assign variable="digit2" expression="(kode / 10) % 10"/>
            <assign variable="digit3" expression="kode % 10"/>
            <output expression="&quot;Digit pertama : &quot; &amp; digit1" newline="True"/>
            <output expression="&quot;Digit kedua : &quot; &amp; digit2" newline="True"/>
            <output expression="&quot;Digit Ketiga : &quot; &amp; digit3" newline="True"/>
            <assign variable="pelacakAwal" expression="digit1 * digit3"/>
            <output expression="&quot;Nilai pelacak awal: &quot; &amp; pelacakAwal" newline="True"/>
            <if expression="digit2 % 2 == 1">
                <then>
                    <assign variable="pelacakTahap1" expression="pelacakAwal + 25"/>
                </then>
                <else>
                    <assign variable="pelacakTahap1" expression="pelacakAwal - digit2"/>
                </else>
            </if>
            <output expression="&quot;Nilai pelacak setelah tahap 1 : &quot; &amp; pelacakTahap1" newline="True"/>
            <if expression="pelacakTahap1 % 3 == 0">
                <then>
                    <assign variable="nilaiAkhir" expression="pelacakTahap1 / 3"/>
                </then>
                <else>
                    <assign variable="nilaiAkhir" expression="pelacakTahap1 * 2"/>
                </else>
            </if>
            <output expression="&quot;Nilai pelacak setelah tahap 2 : &quot; &amp; nilaiAkhir" newline="True"/>
            <if expression="nilaiAkhir  &gt; 50">
                <then>
                    <output expression="&quot;Password terdeteksi : Kategori A &quot;" newline="True"/>
                </then>
                <else>
                    <if expression="nilaiAkhir &gt; 20">
                        <then>
                            <output expression="&quot;Password Terdeteksi : kategori B&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Password Ditolak&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="nilaiakhir % 2 == 0">
                <then>
                    <output expression="&quot;Siklus Genap&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Siklus ganjil&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
